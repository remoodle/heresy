{
  "name": "heresy",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp run lint && vp run -r test && vp run -r build",
    "check": "vp run lint && vp run -r test && vp run -r build",
    "format": "vp fmt",
    "prelint": "vp run @heresy/telegram-bot#paraglide:compile",
    "lint": "vp lint",
    "type-check": "vp run -r type-check",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "dev": "vp run -F @heresy/calendar -F @heresy/server -F @heresy/telegram-bot dev",
    "dev:calendar": "vp run @heresy/calendar#dev",
    "dev:server": "vp run @heresy/server#dev",
    "dev:telegram-bot": "vp run @heresy/telegram-bot#dev",
    "clean:server": "rm -f apps/server/remoodle.db apps/server/remoodle.db-shm apps/server/remoodle.db-wal",
    "db:generate": "vp run @heresy/server#db:generate",
    "db:migrate": "vp run @heresy/server#db:migrate"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "oxlint": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.22.0"
}
