{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchPackageNames": ["node"],
      "matchManagers": ["dockerfile"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["packageManager"],
      "enabled": false
    },
    {
      "matchManagers": ["nvm"],
      "enabled": false
    }
  ],
  "postUpdateOptions": ["pnpmDedupe"]
}
