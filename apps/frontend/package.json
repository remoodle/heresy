{
  "name": "@remoodle/frontend",
  "version": "1.9.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore && prettier --check src/",
    "format": "eslint . --fix --ignore-path .gitignore && prettier --write src/",
    "test": "vitest"
  },
  "dependencies": {
    "@radix-icons/vue": "^1.0.0",
    "@remoodle/utils": "workspace:*",
    "@tanstack/vue-query": "^5.80.2",
    "@vueuse/core": "^13.3.0",
    "@vueuse/router": "^13.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "filesize": "^10.1.6",
    "linkify": "^0.2.1",
    "linkify-html": "^4.3.1",
    "lucide-vue-next": "^0.484.0",
    "pinia": "^2.3.1",
    "posthog-js": "^1.249.3",
    "reka-ui": "^2.3.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.3.4",
    "vue": "^3.5.16",
    "vue-boring-avatars": "^1.4.0",
    "vue-dompurify-html": "^5.3.0",
    "vue-router": "^4.5.1",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@iconify/vue": "^4.3.0",
    "@julr/vite-plugin-validate-env": "^1.3.0",
    "@remoodle/backend": "workspace:*",
    "@remoodle/eslint-config": "workspace:^",
    "@remoodle/prettier-config": "workspace:^",
    "@remoodle/types": "workspace:*",
    "@rushstack/eslint-patch": "^1.3.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.8",
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.15.18",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.17.0",
    "npm-run-all2": "^6.2.6",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "stale-dep": "^0.7.0",
    "typescript": "~5.4.3",
    "vite": "^6.3.5",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vitest": "^3.2.1",
    "vue-tsc": "^2.0.7"
  }
