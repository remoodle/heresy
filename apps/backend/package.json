{
  "name": "@remoodle/backend",
  "version": "2.7.4",
  "type": "module",
  "private": true,
  "exports": {
    "./api": {
      "types": "./src/services/api/index.ts"
    }
  },
  "scripts": {
    "dev:api": "tsx watch src/services/api/index.ts",
    "dev:cluster": "tsx watch src/services/cluster/index.ts",
    "dev": "run-p dev:*",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "TZ=UTC vitest"
  },
  "dependencies": {
    "@bull-board/api": "^6.21.3",
    "@bull-board/hono": "^6.21.3",
    "@hono/node-server": "^1.19.14",
    "@hono/prometheus": "^1.0.3",
    "@hono/zod-validator": "^0.7.6",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.215.0",
    "@opentelemetry/sdk-metrics": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@remoodle/db": "workspace:*",
    "@remoodle/utils": "workspace:*",
    "@total-typescript/shoehorn": "^0.1.2",
    "bullmq": "^5.75.2",
    "bullmq-otel": "^1.3.0",
    "dotenv": "^17.4.2",
    "envalid": "^8.1.1",
    "hono": "^4.12.14",
    "hono-rate-limiter": "^0.5.3",
    "jsonwebtoken": "^9.0.3",
    "moodle-api": "^0.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@remoodle/eslint-config": "workspace:*",
    "@remoodle/tsconfig": "workspace:*",
    "@remoodle/types": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.2",
    "eslint": "^9.39.4",
    "npm-run-all2": "^8.0.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
