{
  "name": "@remoodle/backend",
  "version": "2.6.6",
  "type": "module",
  "private": true,
  "exports": {
    "./api": {
      "types": "./src/services/api/index.ts"
    }
  },
  "scripts": {
    "dev:api": "tsx watch src/services/api/index.ts",
    "dev:cluster": "tsx watch src/services/cluster/index.ts",
    "dev": "run-p dev:*",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "TZ=UTC vitest"
  },
  "dependencies": {
    "@bull-board/api": "^6.12.7",
    "@bull-board/hono": "^6.12.7",
    "@hono/node-server": "^1.19.1",
    "@hono/prometheus": "^1.0.2",
    "@hono/zod-validator": "^0.7.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.204.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.204.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.204.0",
    "@remoodle/db": "workspace:*",
    "@remoodle/utils": "workspace:*",
    "@total-typescript/shoehorn": "^0.1.2",
    "bullmq": "^5.58.5",
    "bullmq-otel": "^1.0.1",
    "dotenv": "^17.2.2",
    "envalid": "^8.1.0",
    "hono": "^4.9.6",
    "hono-rate-limiter": "^0.4.2",
    "jsonwebtoken": "^9.0.2",
    "moodle-api": "^0.1.0",
    "pino": "^9.9.2",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@remoodle/eslint-config": "workspace:*",
    "@remoodle/tsconfig": "workspace:*",
    "@remoodle/types": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "eslint": "^9.34.0",
    "npm-run-all2": "^8.0.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
