{
  "extends": "@remoodle/tsconfig/base.json",
  "compilerOptions": {
    "strict": true,
    "outDir": "dist",
    "types": ["node"],
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": false,
    "jsxImportSource": "hono/jsx"
  },
  "include": ["./src/**/*.ts", "tsup.config.ts"],
  "exclude": ["dist", "node_modules"]
}
