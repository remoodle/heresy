{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "strict": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // Type-only: the bot reads the API's routes from the server source and never bundles it.
    "paths": { "@heresy/server/api": ["../server/src/api/app.ts"] }
  },
  "include": ["./src/**/*.ts"]
}
